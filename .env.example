# Base de datos - PostgreSQL
# Formato: postgresql://USUARIO:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL="postgresql://postgres:password@localhost:5432/amortizationapp"

# NextAuth.js
# URL base de tu aplicación (cambiar en producción)
NEXTAUTH_URL="http://localhost:3000"

# Secret para firmar los JWT (generar con: openssl rand -base64 32)
NEXTAUTH_SECRET="tu-secret-aqui"

# Google OAuth (opcional - para login con Google)
# Obtener credenciales en: https://console.cloud.google.com
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
